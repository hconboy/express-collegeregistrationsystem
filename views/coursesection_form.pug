extends layout

block content
  h1=title

  form(method='POST')
    div.form-group
      label(for='id') Id:
      input#id.form-control(type='text', placeholder='Id' name='id' required value=(undefined===coursesection ? '' : coursesection.id) )
      label(for='title') Title:
      input#title.form-control(type='text', placeholder='Title' name='title' required value=(undefined===coursesection  ? '' : coursesection.title) )
      div.form-group
      label(for='author') Course:
      select#course.form-control(name='course' required)
        option(value='') --Please select a course--
        for course in courses
          if coursesection
            if course._id.toString()===coursesection.course._id.toString()
              option(value=course._id selected) #{course.title}
            else
              option(value=course._id) #{course.title}
          else
            option(value=course._id) #{course.title}
      label(for='section_number') Section Number:
      input#section_number.form-control(type='number', placeholder='Section Number' name='section_number' required value=(undefined===coursesection ? '' : coursesection.section_number) )
      label(for='meeting_days') Meeting Days:
      input#meeting_days.form-control(type='text', placeholder='Meeting Days' name='meeting_days' required value=(undefined===coursesection ? '' : coursesection.meeting_days) )
      div.form-group
      label(for='faculty') Faculty Member:
      select#faculty.form-control(name='faculty' required)
        option(value='') --Please select a faculty member--
        for facultyMember in facultymembers
          if coursesection
            if facultyMember._id.toString()===coursesection.faculty._id.toString()
              option(value=facultyMember._id selected) #{facultyMember.name}
            else
              option(value=facultyMember._id) #{facultyMember.name}
          else
            option(value=facultyMember._id) #{facultyMember.name}
    button.btn.btn-primary(type='submit') Submit

  if errors
    ul
      for error in errors
        li!= error.msg