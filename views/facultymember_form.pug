extends layout

block content
  h1=title

  form(method='POST')
    div.form-group
      label(for='id') Id:
      input#id.form-control(type='number', placeholder='Id' name='id' required value=(undefined===facultyMember ? '' : facultyMember.id) )
      label(for='name') Name:
      input#name.form-control(type='text', placeholder='Name' name='name' required value=(undefined===facultyMember ? '' : facultyMember.name) )
      label(for='department') Department:
      input#department.form-control(type='text', placeholder='Department' name='department' required value=(undefined===facultyMember ? '' : facultyMember.department) )
      label(for='degree') Degree:
      input#degree.form-control(type='text', placeholder='Degree' name='degree' required value=(undefined===facultyMember ? '' : facultyMember.degree) )
    button.btn.btn-primary(type='submit') Submit

  if errors
    ul
      for error in errors
        li!= error.msg