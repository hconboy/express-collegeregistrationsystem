extends layout

block content
  h1=title

  form(method='POST')
    div.form-group
      label(for='id') Id:
      input#id.form-control(type='text', placeholder='Id' name='id' required value=(undefined===course ? '' : course.id) )
      label(for='title') Title:
      input#title.form-control(type='text', placeholder='Title' name='title' required value=(undefined===course ? '' : course.title) )
      label(for='number_of_credits') Credits:
      input#number_of_credits.form-control(type='number', placeholder='Number of Credits' name='number_of_credits' required value=(undefined===course ? '' : course.number_of_credits) )
    button.btn.btn-primary(type='submit') Submit

  if errors
    ul
      for error in errors
        li!= error.msg